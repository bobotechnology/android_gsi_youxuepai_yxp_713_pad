 namespace {
 const bool kEnableLazyHal(property_get_bool("ro.camera.enableLazyHal", false));
+
+bool getU90FrontCameraOrientation(const std::string& id, int32_t* orientation) {
+    if (id != "1" || orientation == nullptr) {
+        return false;
+    }
+
+    const int32_t configured = property_get_int32("ro.u90.camera.front.orientation", -1);
+    switch (configured) {
+        case 0:
+        case 90:
+        case 180:
+        case 270:
+            *orientation = configured;
+            return true;
+        default:
+            return false;
+    }
+}
+
+void maybeOverrideU90FrontCameraOrientation(const std::string& id,
+        CameraMetadata* characteristics) {
+    int32_t configuredOrientation;
+    if (characteristics == nullptr ||
+            !getU90FrontCameraOrientation(id, &configuredOrientation)) {
+        return;
+    }
+
+    camera_metadata_entry facing = characteristics->find(ANDROID_LENS_FACING);
+    if (facing.count != 1 || facing.data.u8[0] != ANDROID_LENS_FACING_FRONT) {
+        return;
+    }
+
+    camera_metadata_entry current = characteristics->find(ANDROID_SENSOR_ORIENTATION);
+    if (current.count != 1) {
+        ALOGW("U90 camera %s: sensor orientation metadata is missing", id.c_str());
+        return;
+    }
+    const int32_t originalOrientation = current.data.i32[0];
+    if (originalOrientation == configuredOrientation) {
+        return;
+    }
+
+    const status_t res = characteristics->update(ANDROID_SENSOR_ORIENTATION,
+            &configuredOrientation, 1);
+    if (res != OK) {
+        ALOGE("U90 camera %s: cannot override sensor orientation: %d", id.c_str(), res);
+        return;
+    }
+
+    ALOGI("U90 camera %s: overriding sensor orientation %d -> %d", id.c_str(),
+            originalOrientation, configuredOrientation);
+}
 } // anonymous namespace
 
