+// The U90 front camera sits on a lift driven through /dev/NOAH_MOTOR. The
+// driver subtracts 0x40c44d00 from the whole command word and indexes a
+// 17-entry jump table, so dir, type, and size must all match. That table has one
+// real movement command, 0x40c44d01, taking the target mode as its argument:
+// 1 = position_top, 2 = position_bottom, 3 = position_selfie. The stock
+// factory-test library routes two of its modes to nr 2 and nr 8, which are empty
+// stubs, so this uses nr 1.
+//
+// physicalFrontCam() cannot carry this: it takes a bare bool, so its "false"
+// cannot be told apart between "the front camera was released" and "some other
+// camera was opened or closed", and the latter would retract the lift while the
+// front camera is still streaming. Hence the front camera id check below.
+//
+// Id 1 is the physical front camera on this device, not a build-time knob.
+constexpr char kU90FrontCameraId[] = "1";
+constexpr unsigned long kU90MotorRequestMove = 0x40c44d01UL;
+constexpr int kU90MotorModeSelfie = 3;
+constexpr int kU90MotorModeBottom = 2;
+
+static void u90FrontCameraLift(bool on) {
+    if (access("/dev/NOAH_MOTOR", F_OK) != 0) {
+        return;
+    }
+
+    const int fd = ::open("/dev/NOAH_MOTOR", O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("U90 front camera lift: cannot open /dev/NOAH_MOTOR: %s", strerror(errno));
+        return;
+    }
+
+    int mode = on ? kU90MotorModeSelfie : kU90MotorModeBottom;
+    if (::ioctl(fd, kU90MotorRequestMove, &mode) < 0) {
+        ALOGE("U90 front camera lift %s failed: %s", on ? "up" : "down", strerror(errno));
+    } else {
+        ALOGI("U90 front camera lift %s", on ? "up" : "down");
+    }
+    ::close(fd);
+}
