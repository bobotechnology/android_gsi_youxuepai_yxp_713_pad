+// The U90 (yxp_713_pad) front camera sits on a lift driven through
+// /dev/NOAH_MOTOR. The driver subtracts 0x40c44d00 from the whole command word
+// and indexes a 17-entry jump table, so dir, type, and size must all match;
+// anything else returns 0 without doing anything. That table has exactly one
+// real movement command, 0x40c44d01, and it takes the target mode as its int
+// argument: 1 = position_top, 2 = position_bottom, 3 = position_selfie. The
+// stock factory-test library's table {00,01,02,08} therefore contains three
+// stubs (nr 2 and nr 8 do nothing at all), which is why this uses nr 1.
+//
+// The Hall closed loop lives in the kernel, so the request returns as soon as
+// the motor starts; this does not wait for the move to finish, because the
+// camera stack only needs the module to be on its way up before the sensor is
+// opened.
+//
+// This is driven from the two places that already track the physical front
+// camera, but scoped to the front camera id. CameraService::physicalFrontCam()
+// cannot be reused for the call: it takes a bare bool, so its "false" is
+// indistinguishable between "the front camera was released" and "some other
+// camera was opened or closed", and the latter would retract the lift while the
+// front camera is still streaming.
+//
+// Camera id 1 is the physical front camera on the U90, as established for the
+// orientation override next door; it follows from the device's provider layout,
+// so it is a device constant and not a build-time knob.
+constexpr char kU90FrontCameraId[] = "1";
+constexpr unsigned long kU90MotorRequestMove = 0x40c44d01UL;
+constexpr int kU90MotorModeSelfie = 3;
+constexpr int kU90MotorModeBottom = 2;
+
+static void u90FrontCameraLift(bool on) {
+    if (access("/dev/NOAH_MOTOR", F_OK) != 0) {
+        return;
+    }
+
+    const int fd = ::open("/dev/NOAH_MOTOR", O_RDWR | O_CLOEXEC);
+    if (fd < 0) {
+        ALOGE("U90 front camera lift: cannot open /dev/NOAH_MOTOR: %s", strerror(errno));
+        return;
+    }
+
+    int mode = on ? kU90MotorModeSelfie : kU90MotorModeBottom;
+    if (::ioctl(fd, kU90MotorRequestMove, &mode) < 0) {
+        ALOGE("U90 front camera lift %s failed: %s", on ? "up" : "down", strerror(errno));
+    } else {
+        ALOGI("U90 front camera lift %s", on ? "up" : "down");
+    }
+    ::close(fd);
+}
