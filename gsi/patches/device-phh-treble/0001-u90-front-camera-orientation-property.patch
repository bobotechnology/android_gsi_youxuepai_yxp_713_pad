diff --git a/base.mk b/base.mk
index 301fee9..6707229 100644
--- a/base.mk
+++ b/base.mk
@@ -19,6 +19,8 @@ $(call inherit-product, vendor/hardware_overlay/overlay.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit.mk)
 $(call inherit-product, $(SRC_TARGET_DIR)/product/aosp_base_telephony.mk)
 
+PRODUCT_DEFAULT_LOCALE := zh-CN
+
 #Those overrides are here because Huawei's init read properties
 #from /system/etc/prop.default, then /vendor/build.prop, then /system/build.prop
 #So we need to set our props in prop.default
@@ -29,7 +31,15 @@ PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
 	ro.build.version.release=$(PLATFORM_VERSION) \
 	ro.build.version.security_patch=$(PLATFORM_SECURITY_PATCH) \
 	ro.adb.secure=0 \
-	ro.logd.auditd=true
+	ro.logd.auditd=true \
+	persist.sys.locale=zh-CN \
+	persist.sys.timezone=Asia/Shanghai \
+	persist.sys.time_12_24=24
+
+ifneq ($(strip $(U90_FRONT_CAMERA_ORIENTATION)),)
+PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
+	ro.u90.camera.front.orientation=$(U90_FRONT_CAMERA_ORIENTATION)
+endif
 	
 #Huawei HiSuite (also other OEM custom programs I guess) it's of no use in AOSP builds
 PRODUCT_SYSTEM_DEFAULT_PROPERTIES += \
